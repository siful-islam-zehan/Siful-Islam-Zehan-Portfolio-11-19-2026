# ==============================================================================
# SIFUL ISLAM ZEHAN — PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these keys to Project Settings -> Environment Variables.
#
# NOTE: Never commit your real .env.local file.
# Never expose your Supabase service_role key to client-side code.
# ==============================================================================

# Supabase Project URL (Found in: Supabase Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Administrator Email (Used for login gate verification)
NEXT_PUBLIC_ADMIN_EMAIL=sisamasri@gmail.com
ADMIN_EMAIL=sisamasri@gmail.com

# Formspree Contact Form Endpoint (Found in: Formspree Dashboard -> Your Form -> Endpoint)
# Target Notification Recipient: sisamasri@gmail.com
# Example: https://formspree.io/f/mqkvrpqy or form ID: mqkvrpqy
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
